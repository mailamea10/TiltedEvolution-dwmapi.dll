From e4cbeee3d8a081c5f0063ccf2bd89e1c7fc76ce1 Mon Sep 17 00:00:00 2001
From: absol89 <absol89@users.noreply.github.com>
Date: Wed, 21 Oct 2026 01:18:02 +0200
Subject: [PATCH] fix: unknown names show as italic Stranger#<id> instead of
 #<id>

When a revealed player's name isn't in the player list (e.g. after a party kick), the tag keeps the player id so they can still be identified, styled like other hidden names.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Code/client/Services/Generic/NameTagService.cpp | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/Code/client/Services/Generic/NameTagService.cpp b/Code/client/Services/Generic/NameTagService.cpp
index 5ef09f35a..db021519a 100644
--- a/Code/client/Services/Generic/NameTagService.cpp
+++ b/Code/client/Services/Generic/NameTagService.cpp
@@ -184,15 +184,22 @@ void NameTagService::OnDraw() noexcept
             continue;
 
         // Name from the party UI's player list (keyed by player id).
-        const bool isNameRevealed = m_settings.RevealedPlayerIds.count(playerComponent.Id) > 0;
+        bool isNameRevealed = m_settings.RevealedPlayerIds.count(playerComponent.Id) > 0;
         std::string displayName = strangerLabel;
         if (isNameRevealed)
         {
-            displayName = "#" + std::to_string(playerComponent.Id);
             const auto& players = partyService.GetPlayers();
             auto it = players.find(playerComponent.Id);
             if (it != players.end() && !it->second.empty())
+            {
                 displayName = it->second.c_str();
+            }
+            else
+            {
+                // No name known (e.g. after a kick): keep the player id so they can still be identified.
+                displayName += "#" + std::to_string(playerComponent.Id);
+                isNameRevealed = false;
+            }
         }
 
         const NiPoint3 anchor = BuildAnchorPoint(pActor);
