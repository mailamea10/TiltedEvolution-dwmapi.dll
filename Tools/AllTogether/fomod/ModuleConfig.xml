<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
  <moduleName>AllTogether SKSE (Skyrim Together Add-ons Bundle 1)</moduleName>
  <moduleImage path="fomod\images\Ragdoll-Together.png" />
  <requiredInstallFiles><folder source="Docs" destination="Docs" priority="0" /></requiredInstallFiles>
  <installSteps order="Explicit">
    <installStep name="Select add-ons">
      <optionalFileGroups order="Explicit"><group name="Choose the add-ons to install" type="SelectAny"><plugins order="Explicit">
        <plugin name="Ragdoll/Physics Together 1.0.0"><description>Synchronizes ragdoll and physics motion. Requires STR and SKSE. SKSE: https://skse.silverlock.org/</description><image path="fomod\images\Ragdoll-Together.png" /><files><folder source="Add-ons\Ragdoll\SKSE\Plugins" destination="SKSE\Plugins" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="LipSync Together 0.8.0"><description>Synchronizes mouth movement and optional voice chat. Requires SKSE and Mfg Fix NG or Mfg Fix for your runtime. Mfg Fix NG: https://www.nexusmods.com/skyrimspecialedition/mods/133568 | Mfg Fix: https://www.nexusmods.com/skyrimspecialedition/mods/11669</description><image path="fomod\images\LipSync-Together.jpg" /><conditionFlags><flag name="lipsync">1</flag></conditionFlags><files><folder source="Add-ons\LipSync\SKSE\Plugins" destination="SKSE\Plugins" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="RaceMenu Together 1.0.0"><description>Synchronizes RaceMenu appearance. Requires RaceMenu for your Skyrim runtime, SKSE, and Address Library on 1.6.x/1.7.x. RaceMenu: https://www.nexusmods.com/skyrimspecialedition/mods/19080 | Address Library: https://www.nexusmods.com/skyrimspecialedition/mods/32444</description><image path="fomod\images\RaceMenu-Together.jpg" /><files><folder source="Add-ons\RaceMenu\SKSE\Plugins" destination="SKSE\Plugins" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="SkyParkour Together 1.0.1"><description>Synchronizes SkyParkour animations. Requires SkyParkour, SKSE, and Address Library. SkyParkour: https://www.nexusmods.com/skyrimspecialedition/mods/132292 | Address Library: https://www.nexusmods.com/skyrimspecialedition/mods/32444</description><image path="fomod\images\SkyParkour-Together.png" /><files><folder source="Add-ons\SkyParkour\SKSE\Plugins" destination="SKSE\Plugins" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Choose Skyrim Together version">
      <optionalFileGroups order="Explicit"><group name="Which STR server version do you join?" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="STR 1.8.7 (AllTogether, recommended)"><description>Use with STR 1.8.7 servers. Supports Skyrim 1.7.104 and 1.6.1170/1.6.1179. Includes the PR #16 nametag/player UI features.</description><conditionFlags><flag name="str">187</flag></conditionFlags><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="STR 1.8.6 (absol89 playtest)"><description>Use only with matching 1.8.6 playtest servers.</description><conditionFlags><flag name="str">186</flag></conditionFlags><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
        <plugin name="STR 1.8.5 (absol89)"><description>Use with STR 1.8.5 servers. Skyrim 1.5.97 is supported only by this STR version.</description><conditionFlags><flag name="str">185</flag></conditionFlags><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
        <plugin name="STR 1.8.3 (official Nexus)"><description>Use with official STR 1.8.3 servers.</description><conditionFlags><flag name="str">183</flag></conditionFlags><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>

    <installStep name="Skyrim runtime (STR 1.8.7)"><visible><flagDependency flag="str" value="187" /></visible>
      <optionalFileGroups order="Explicit"><group name="Select your Skyrim runtime" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Skyrim 1.7.104"><description>Skyrim AE 1.7.104.</description><files><folder source="Launchers\187-1.7.104\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="Skyrim 1.6.1170 / 1.6.1179"><description>One launcher supports both 1.6.1170 and 1.6.1179.</description><files><folder source="Launchers\187-1.6.1170\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Skyrim runtime (STR 1.8.6)"><visible><flagDependency flag="str" value="186" /></visible>
      <optionalFileGroups order="Explicit"><group name="Select your Skyrim runtime" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Skyrim 1.7.104"><files><folder source="Launchers\186-1.7.104\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="Skyrim 1.6.1170 / 1.6.1179"><files><folder source="Launchers\186-1.6.1170\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Skyrim runtime (STR 1.8.5)"><visible><flagDependency flag="str" value="185" /></visible>
      <optionalFileGroups order="Explicit"><group name="Select your Skyrim runtime" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Skyrim 1.7.104"><files><folder source="Launchers\185-1.7.104\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="Skyrim 1.6.1170 / 1.6.1179"><files><folder source="Launchers\185-1.6.1170\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
        <plugin name="Skyrim 1.5.97"><description>Only supported with STR 1.8.5. This build includes the KiLoader dependency search path fix.</description><files><folder source="Launchers\185-1.5.97\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
    <installStep name="Skyrim runtime (STR 1.8.3)"><visible><flagDependency flag="str" value="183" /></visible>
      <optionalFileGroups order="Explicit"><group name="Select your Skyrim runtime" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Skyrim 1.7.104"><files><folder source="Launchers\183-1.7.104\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="Skyrim 1.6.1170 / 1.6.1179"><files><folder source="Launchers\183-1.6.1170\SkyrimTogetherReborn" destination="SkyrimTogetherReborn" priority="0" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>

    <installStep name="LipSync voice relay access"><visible><flagDependency flag="lipsync" value="1" /></visible>
      <optionalFileGroups order="Explicit"><group name="Who can join LipSync voice chat?" type="SelectExactlyOne"><plugins order="Explicit">
        <plugin name="Secure — require a Skyrim Together session key"><description>Recommended. Accepts players with a key relayed through the same STR server. STR retains keys until the server restarts.</description><files><file source="fomod\security\LipSyncTogether-Secure.ini" destination="SKSE\Plugins\LipSyncTogether.ini" /></files><typeDescriptor><type name="Recommended" /></typeDescriptor></plugin>
        <plugin name="Open relay"><description>Anyone who can reach the host's UDP 10579 port can join voice chat. Use only on a trusted network.</description><files><file source="fomod\security\LipSyncTogether-Open.ini" destination="SKSE\Plugins\LipSyncTogether.ini" /></files><typeDescriptor><type name="Optional" /></typeDescriptor></plugin>
      </plugins></group></optionalFileGroups>
    </installStep>
  </installSteps>
</config>
